---
import Layout from '../layouts/Layout.astro';
import ToolGrid from '../components/ToolGrid';
import AdSlot from '../components/AdSlot';
import { VideoIcon, BookOpenIcon, ImageIcon } from '../components/Icons';
---

<Layout 
  title="Toolix - Free Media & PDF Tools"
  description="Convert video to MP3 audio, merge PDF files, split PDFs, trim video clips, compress images, and convert format files instantly."
>
  
  <!-- Hero Section -->
  <section class="relative py-12 md:py-16 overflow-hidden border-b border-black/5 dark:border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center space-y-4">
      
      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100 max-w-3xl mx-auto leading-tight">
        Free Media & PDF Tools. <br />
        <span class="gradient-text">Fast & Simple.</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-xl mx-auto leading-relaxed">
        Extract audio, merge PDFs, trim videos, and convert format files instantly. Free forever with zero file size limits.
      </p>

    </div>
  </section>

  <!-- Top AdSlot -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <AdSlot client:only="solid-js" format="horizontal" />
  </div>

  <!-- Interactive Tools Grid Section -->
  <section class="py-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <ToolGrid client:only="solid-js" />
  </section>

  <!-- Features Section -->
  <section id="about" class="py-12 bg-slate-100/60 dark:bg-slate-950/60 border-t border-b border-black/5 dark:border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-xl mx-auto mb-8 space-y-2">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-slate-100">Designed for Speed & Efficiency</h2>
        <p class="text-xs text-slate-600 dark:text-slate-400">All tools operate instantly directly within your browser window.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        
        <div class="glass-card rounded-md p-5 space-y-2">
          <div class="w-8 h-8 rounded bg-[#FA9A85]/10 border border-[#FA9A85]/20 text-[#FA9A85] flex items-center justify-center font-bold text-sm">
            <VideoIcon class="w-4 h-4" />
          </div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">Video & Audio Processing</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Extract high-fidelity MP3 audio, trim video timestamps, compress sizes, and convert formats seamlessly.
          </p>
        </div>

        <div class="glass-card rounded-md p-5 space-y-2">
          <div class="w-8 h-8 rounded bg-[#E6986C]/10 border border-[#E6986C]/20 text-[#E6986C] flex items-center justify-center font-bold text-sm">
            <BookOpenIcon class="w-4 h-4" />
          </div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">PDF Suite</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Merge multiple PDF files, extract page ranges, convert PDF pages to PNG/JPG, and rotate document orientations.
          </p>
        </div>

        <div class="glass-card rounded-md p-5 space-y-2">
          <div class="w-8 h-8 rounded bg-[#B0A6DF]/10 border border-[#B0A6DF]/20 text-[#B0A6DF] flex items-center justify-center font-bold text-sm">
            <ImageIcon class="w-4 h-4" />
          </div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">Image Utilities</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Convert photos between WebP, PNG, and JPG formats with quality compression controls.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- Bottom AdSlot -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <AdSlot client:only="solid-js" format="horizontal" />
  </div>

</Layout>
