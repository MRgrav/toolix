---
import { TOOLS_REGISTRY } from '../utils/toolsRegistry';
---

<footer class="mt-auto border-t border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-slate-950/90 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      
      <!-- Brand Info -->
      <div class="md:col-span-1 space-y-3">
        <a href="/" class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-md gradient-bg flex items-center justify-center font-bold text-slate-950 text-sm">
            T
          </div>
          <span class="text-base font-bold text-slate-900 dark:text-slate-100">Toolix</span>
        </a>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Fast, simple, and free online media & PDF tools powered by client-side browser processing.
        </p>
        <div class="text-[11px] text-slate-500 font-mono">
          © {new Date().getFullYear()} Toolix. All rights reserved.
        </div>
      </div>

      <!-- Video & Audio Tools -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-[#FA9A85] mb-3">Video & Audio</h4>
        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
          {TOOLS_REGISTRY.filter(t => t.category === 'video-audio').map(t => (
            <li>
              <a href={`/tools/${t.slug}`} class="hover:text-[#FA9A85] transition-colors">
                {t.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- PDF Tools -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-[#E6986C] mb-3">PDF Utilities</h4>
        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
          {TOOLS_REGISTRY.filter(t => t.category === 'pdf').map(t => (
            <li>
              <a href={`/tools/${t.slug}`} class="hover:text-[#E6986C] transition-colors">
                {t.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Information -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-[#B0A6DF] mb-3">Information</h4>
        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
          <li>
            <a href="/privacy" class="hover:text-[#B0A6DF] transition-colors">Privacy Policy</a>
          </li>
          <li>
            <a href="/#about" class="hover:text-[#B0A6DF] transition-colors">About Toolix</a>
          </li>
        </ul>
      </div>

    </div>
  </div>
</footer>
