---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  canonicalUrl?: string;
  adSensePublisherId?: string;
}

const {
  title = "Toolix - Free Online Media & PDF Tools",
  description = "Fast, free online browser tools for Video to MP3 extraction, PDF merging, PDF splitting, image compression, and video trimming.",
  keywords = ["online tools", "pdf merge", "pdf split", "video to mp3", "free pdf tools", "image converter"],
  canonicalUrl = Astro.url.href,
  adSensePublisherId = "ca-pub-0000000000000000"
} = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": title,
  "description": description,
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "Any Browser",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};
---

<!ts-html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Google Ads -->
    <meta name="google-adsense-account" content="ca-pub-5591235870596420">

    <!-- Theme Initialization Script -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Google AdSense Script Placeholder -->
    {adSensePublisherId && adSensePublisherId !== 'ca-pub-0000000000000000' && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adSensePublisherId}`} crossorigin="anonymous"></script>
    )}

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-slate-50 dark:bg-[#0a0d14] text-slate-900 dark:text-slate-100 font-sans antialiased min-h-screen flex flex-col transition-colors">
    
    <Navbar />

    <main class="flex-grow">
      <slot />
    </main>

    <Footer />

  </body>
</html>
